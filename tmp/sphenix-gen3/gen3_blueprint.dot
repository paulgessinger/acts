digraph BlueprintNode {
Root [label=<World>, shape=house, style=solid];
"Root" -> "sPHENIX";
sPHENIX [label=<<b>sPHENIX</b><br/>CylinderContainer<br/>dir: AxisR>, shape=doubleoctagon, style=solid];

  "sPHENIX" -> "BeamPipeRegion" [style=solid];

BeamPipeRegion [label=<<b>BeamPipeRegion</b><br/>Cylinder>, shape=rectangle, style=solid];
  "sPHENIX" -> "MVTX" [style=solid];

MVTX [label=<<br/><b>MVTX</b><br/>Layer<br/><i>Cylinder</i>>, shape=diamond, style=solid];
  "sPHENIX" -> "Silicon" [style=solid];

Silicon [label=<<br/><b>Silicon</b><br/>Layer<br/><i>Cylinder</i>>, shape=diamond, style=solid];
  "sPHENIX" -> "TPC" [style=solid];

TPC [label=<<b>TPC</b><br/>CylinderContainer<br/>dir: AxisR>, shape=doubleoctagon, style=solid];

    "TPC" -> "TPC|L0_Mat" [style=solid];

TPC|L0_Mat [label=<<b>TPC|L0_Mat</b><br/>MaterialDesignator<br/><i>Cylinder Binning</i><br/> at: InnerCylinder: AxisRPhi=36, AxisZ=50<br/> at: OuterCylinder: AxisRPhi=36, AxisZ=50>, shape=hexagon, style=solid];
      "TPC|L0_Mat" -> "TPC|L0";
